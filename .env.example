# Optional connected-install choices. The packaged Compose file has working
# localhost defaults, so copying this file to .env is not required.
# Runtime secrets are generated once and persisted under the deployment data
# root; they do not belong in this operator override file.

# Keep these URLs and host ports aligned when exposing Central on another name
# or port. Add every certificate name or IP that operators and Echoes will use.
CENTRAL_PUBLIC_URL=https://localhost
CENTRAL_ECHO_PUBLIC_URL=https://localhost
CENTRAL_ECHO_MTLS_PUBLIC_URL=https://localhost:9443
CENTRAL_HTTPS_PORT=443
CENTRAL_MTLS_PORT=9443
CENTRAL_DEPLOYMENT_DNS_NAMES=localhost
CENTRAL_DEPLOYMENT_IP_SANS=127.0.0.1
CENTRAL_OPERATOR_LOCALHOST_ENABLED=true

# Give each installation on the same Docker host a distinct project name.
CENTRAL_COMPOSE_PROJECT_NAME=unicron-central

# The default keeps deployment data beside compose.yaml. Set an absolute host
# path before first startup when another durable location is preferred.
CENTRAL_OPERATOR_DATA_ROOT=

# The first browser sign-in sets this owner's password.
CENTRAL_OWNER_USERNAME=owner
